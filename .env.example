# Copy to .env and fill in. Never commit real values.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres everywhere, including local development — there is no SQLite fallback.
# The default below matches the docker command in the README; override for
# staging and production (RDS).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/testmuai_certifications

# --- Email — see the Email section of config/settings.py ---------------------
# Locally: Mailpit, from docker compose. Every email lands in its inbox at
# http://localhost:8025 — nothing is delivered to anyone.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# The one company address every email is sent from, and replies go to.
DEFAULT_FROM_EMAIL=certifications@testmuai.com
SITE_URL=http://127.0.0.1:8000
# Demo (PythonAnywhere) only: email the person who acted, not the candidate.
EMAIL_SEND_TO_ACTOR=False
#
# Production (Gmail / Google Workspace), once IT sets up the App Password:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=<the company address>
# EMAIL_HOST_PASSWORD=<the 16-character app password>

# --- Identity (TestMu AI OIDC) — not wired up yet -----------------------------
# See archived/docs/auth.md. This app never stores passwords.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUTH_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=

# --- Celery / Redis — not wired up yet ---------------------------------------
# REDIS_URL=redis://localhost:6379/0
