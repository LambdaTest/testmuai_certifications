# Copy to .env and fill in. Never commit real values.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres is the target for staging and production. Omit this locally and
# Django falls back to SQLite so the project runs with no setup.
# DATABASE_URL=postgres://user:pass@localhost:5432/testmuai_certifications

# --- Identity (TestMu AI OIDC) — not wired up yet -----------------------------
# See archived/docs/auth.md. This app never stores passwords.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUTH_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=

# --- Celery / Redis — not wired up yet ---------------------------------------
# REDIS_URL=redis://localhost:6379/0
