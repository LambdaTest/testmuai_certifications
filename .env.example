# Copy to .env.local and fill in. Never commit real values.
# Every variable here must also be declared in src/lib/env.ts so the app fails fast on boot.

# --- Database (Neon via Vercel Marketplace) -----------------------------------
# Use the POOLED connection string for the app. Serverless functions open many
# short-lived connections; the unpooled string will exhaust Postgres.
DATABASE_URL=

# Unpooled/direct connection — used ONLY by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=

# --- Auth ---------------------------------------------------------------------
# Provider not yet chosen — see open decision #4 in README.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Redis (Upstash) — rate limiting and cache only, NOT job queues ------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Vercel Blob — question media, and certificate PDFs if we ever store them --
BLOB_READ_WRITE_TOKEN=

# --- Application --------------------------------------------------------------
# Public base URL. Used to build credential verification links that get printed
# on certificates and shared to LinkedIn — must be correct in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign credential verification tokens. Rotating this invalidates
# every outstanding verification link — treat as long-lived.
CREDENTIAL_SIGNING_SECRET=

# Shared secret for /api/cron/* routes so only Vercel Cron can invoke them.
CRON_SECRET=
